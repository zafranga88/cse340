<%- include('partials/header') %>

<main>
    <h1><%= category.name %></h1>

    <p>Projects in this category:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </li>
        <% }); %>
    </ul>
    <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
</main>

<%- include('partials/footer') %>